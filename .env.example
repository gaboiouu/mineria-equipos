# ============================================
# Registro de Equipos Mineros - Variables de entorno
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env al repositorio.
# ============================================

# --- Base de datos (PostgreSQL en Neon) ---
# Obtenla en Neon: Connect > connection string
# Cambia el final a sslmode=verify-full
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full

# --- Backend ---
# Puerto donde corre la API en local
PORT=3000

# URL publica del frontend, usada para CORS
# Local: http://localhost:5173 | Produccion: URL de Vercel
FRONTEND_URL=http://localhost:5173

# --- Frontend ---
# URL del backend que consume el frontend
# Local: http://localhost:3000 | Produccion: URL de Render
VITE_API_URL=http://localhost:3000