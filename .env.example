# ============================================
# Registro de Equipos Mineros - Variables de entorno
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env al repositorio.
# ============================================

# --- Base de datos (PostgreSQL en Neon) ---
# Obtenla en Neon: Connect > connection string
# Cambia el final a sslmode=verify-full
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full

# --- Backend ---
# Puerto donde corre la API en local
PORT=3000

# URL publica del frontend, usada para CORS
# Local: http://localhost:5173 | Produccion: URL de Vercel
FRONTEND_URL=http://localhost:5173

# --- Frontend ---
# URL del backend que consume el frontend
# Local: http://localhost:3000 | Produccion: URL de Render
VITE_API_URL=http://localhost:3000

# --- Despliegue (deploy.sh) ---
# Render: servicio > Settings > Deploy Hook
RENDER_DEPLOY_HOOK=https://api.render.com/deploy/srv-xxxx?key=xxxx

# Vercel: vercel.com/account/tokens
VERCEL_TOKEN=your_vercel_token

# Vercel: archivo .vercel/repo.json (se crea con "vercel link")
VERCEL_ORG_ID=your_org_id
VERCEL_PROJECT_ID=your_project_id

# URLs publicas de produccion, usadas para el health check final
BACKEND_URL=https://your-api.onrender.com
FRONTEND_PUBLIC_URL=https://your-app.vercel.app